# Desktop Control API — 复制本文件为 `.env` 后填写（`.env` 已 gitignore）
# 加载顺序：项目内 `import env_bootstrap` 或 `import settings` 时会自动加载 `.env`；
# 已存在于操作系统中的环境变量不会被 .env 覆盖（override=False）。

# --- 服务（python server.py）---
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8765
DESKTOP_API_KEY=desktop-control-key
# 多密钥（逗号分隔，优先于 DESKTOP_API_KEY）
# DESKTOP_API_KEYS=key_a,key_b
DESKTOP_LOG_LEVEL=INFO
# 1=注册诊断路由：/ocr/read_window、/locate/*（默认 0，生产建议关闭）
# DESKTOP_EXPOSE_DEBUG_ROUTES=0
# 仅当你明确接受默认弱密钥时设为 1
DESKTOP_ALLOW_INSECURE_DEFAULT_KEY=0

# --- 客户端脚本（test_client、manual_*、test_ui_dom_reader 等）---
DESKTOP_API_BASE=http://127.0.0.1:8765
# 未设置时各脚本保留各自原默认；设置后统一覆盖
# DESKTOP_HTTP_TIMEOUT_S=60
DESKTOP_OCR_LANG=chi_sim+eng

# UIA 读树默认深度（未在请求 JSON 中传 max_depth 时；范围 clamp 到 1–30）
DESKTOP_UI_MAX_DEPTH=8

# --- Tesseract（可选，见 Tesseract 文档）---
# TESSDATA_PREFIX=

# --- OpenTelemetry ---
# OTEL_SERVICE_NAME=desktop-control-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- 集成 / 实机测试（pytest）---
# RUN_DESKTOP_INTEGRATION_TESTS=1
# RUN_DESKTOP_ACTION_TESTS=1
# RUN_OCR_WINDOW_TESTS=1
# DESKTOP_TEST_API_BASE=http://127.0.0.1:8765
# DESKTOP_TEST_API_KEY=desktop-control-key
# DESKTOP_OCR_WINDOW_TITLE=
# DESKTOP_OCR_BOUNDS_TOLERANCE=0.08
# DESKTOP_OCR_REPEAT=4
# DESKTOP_OCR_REQUIRE_SCALE=

# 开发热重载请在项目根执行（勿依赖 python server.py 的 reload）:
# uvicorn server:app --host 127.0.0.1 --port 8765 --reload
